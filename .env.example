# Explicit demo mode; deterministic fixtures + local mock evaluator, NO external model calls.
APP_MODE=mock
HOST=127.0.0.1
PORT=3000
WORLD_DB=data/world.sqlite
WORLD_EPOCH=direct-typesafe-jev-1

# Direct System One decisions API (Jev evaluator). The json-render composer stays
# official; the evaluator is our server-side adapter to the endpoint below.
# TypeSafe:  JEV_BASE_URL=https://api.typesafe.ai/v1   + JEV_PATH=/systemone (default)
# OpenRouter: JEV_BASE_URL=https://openrouter.ai/api/alpha + JEV_PATH=/decisions
JEV_BASE_URL=https://api.typesafe.ai/v1
JEV_PATH=/systemone
JEV_MODEL=jev-latest
JEV_API_KEY=
# Alias also accepted: TYPESAFE_API_KEY
JEV_EVALUATION_TIMEOUT_MS=10000
JEV_COMPOSE_TIMEOUT_MS=45000
JEV_COMPOSE_MAX_STEPS=4
JEV_COMPOSE_MAX_ELEMENTS=32
JEV_COMPOSE_MAX_DEPTH=4

# OpenAI-compatible content generator. Base URL, NOT the full /chat/completions URL.
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-flash
OPENAI_API_KEY=
OPENAI_JSON_MODE=json_object
# omit for generic providers; disabled is a DeepSeek-specific extension.
OPENAI_THINKING=disabled
OPENAI_MAX_TOKENS=4096
REQUEST_TIMEOUT_MS=120000
